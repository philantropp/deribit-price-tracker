# Read by docker compose (variable interpolation) and by the app when run without Docker.
POSTGRES_USER=prices
POSTGRES_PASSWORD=prices
POSTGRES_DB=prices
API_PORT=8000
LOG_LEVEL=INFO

# Only for running the app outside Docker (compose builds these URLs itself):
DATABASE_URL=postgresql+asyncpg://prices:prices@localhost:5432/prices
CELERY_BROKER_URL=redis://localhost:6379/0
# DERIBIT_BASE_URL=https://www.deribit.com/api/v2
# DERIBIT_TIMEOUT_SECONDS=10
# PRICE_COLLECTION_INTERVAL_SECONDS=60
